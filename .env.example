# 환경 변수 목록 (값은 예시). 이 파일은 커밋되며 실제 비밀 값을 넣지 않는다.

# --- 사이트 공개 정보 (.env에 있음, 브라우저 번들에 들어감) ---
VITE_SITE_URL=https://example.com
VITE_CONTACT_EMAIL=contact@example.com
VITE_LAST_UPDATED=2026-10-04
# 운영자 이름: 개인정보처리방침·소개 페이지에 표시. 실명은 저장소에 커밋하지 말고 Vercel 환경 변수(Production·Preview)에 넣는다.
# Production 빌드는 이 값이 자리 표시([운영자 이름])로 남아 있으면 실패한다(scripts/check-production.ts).
VITE_OPERATOR_NAME=[운영자 이름]

# --- 서버 전용 비밀 값 (브라우저에 절대 들어가지 않음) ---
# 세션 토큰 HMAC 서명 키. 32자 이상 무작위 문자열.
# 없으면 /api/session, /api/report가 server_misconfigured(500) 오류로 실패한다.
# 로컬: .env.local에 넣는다(커밋 금지).  배포: Vercel 프로젝트 환경 변수에 등록한다.
# 만들기 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REPORT_TOKEN_SECRET=

# --- 로그인·이용권 (Supabase) ---
# 기능 스위치. 둘 다 "true"가 아니면 이전과 똑같이 동작한다(로그인 없음, 결과 전체 공개).
#   MONETIZATION_ENABLED: 서버가 로그인·이용권에 따라 채점 응답을 자를지 (서버 전용)
#   VITE_MONETIZATION_ENABLED: 로그인 버튼, 이용권 안내, 무료 1회 제한 화면과 안내 문구를 넣어 빌드할지 (빌드 시점에 정해짐)
MONETIZATION_ENABLED=
VITE_MONETIZATION_ENABLED=
# 카카오 로그인 (보류 중, 기본 꺼짐). "true"일 때만 카카오 버튼·안내 문구를 넣고 카카오 로그인 시작을 허용한다 (빌드 시점에 정해짐)
VITE_KAKAO_LOGIN_ENABLED=

# Supabase 프로젝트 주소와 공개 키(anon 또는 publishable). 브라우저 번들에 들어가는 공개 값.
# 서버도 VITE_SUPABASE_URL을 읽는다(SUPABASE_URL을 따로 두면 서버는 그 값을 먼저 쓴다).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 전용 비밀 값: Supabase 서비스 키(service_role 또는 secret). RLS를 우회하므로 절대 공개하지 않는다.
# VITE_ 접두어를 붙이면 브라우저 번들에 들어가므로 이름을 바꾸지 말 것. 로컬은 .env.local, 배포는 Vercel 환경 변수.
SUPABASE_SERVICE_ROLE_KEY=
